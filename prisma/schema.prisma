generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id            String   @id @default(cuid())
  businessName  String
  phone         String?
  email         String?
  address       String?
  currency      Currency @default(NGN)
  bankName      String?
  accountName   String?
  accountNumber String?
  receiptFooter String?
  instagram     String?
  facebook      String?
  whatsapp      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  logoKey       String?
}

model User {
  id                   String         @id @default(cuid())
  firstName            String
  lastName             String
  email                String         @unique
  passwordHash         String
  role                 UserRole       @default(ADMIN)
  isActive             Boolean        @default(true)
  lastLoginAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deletedAt            DateTime?
  hashedRefreshToken   String?
  phone                String?
  userId               String         @unique
  createdCustomers     Customer[]     @relation("CustomerCreatedBy")
  recordedExpenses     Expense[]      @relation("UserRecordedExpenses")
  createdLedgerEntries LedgerEntry[]  @relation("UserCreatedLedgerEntries")
  notifications        Notification[]
  createdOrders        Order[]        @relation("UserCreatedOrders")
  receivedPayments     Payment[]      @relation("UserReceivedPayments")
  generatedReceipts    Receipt[]      @relation("UserGeneratedReceipts")
  processedRefunds     Refund[]       @relation("UserProcessedRefunds")

  @@index([email])
  @@index([role])
}

model Customer {
  id             String    @id @default(cuid())
  name           String
  phone          String
  email          String?
  defaultAddress String?
  notes          String    @default("")
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  customerId     String    @unique
  createdBy      User      @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  orders         Order[]   @relation("CustomerOrders")

  @@index([name])
  @@index([phone])
  @@index([createdById])
}

model ProductCategory {
  id          String      @id @default(cuid())
  name        String      @unique
  description String      @default("")
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  categoryId  String      @unique
  orderItems  OrderItem[]

  @@index([name])
  @@index([isActive])
}

model ExpenseCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  description String    @default("")
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  categoryId  String    @unique
  expenses    Expense[]

  @@index([name])
  @@index([isActive])
}

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  customerId      String
  orderDate       DateTime       @default(now())
  deliveryDate    DateTime
  deliveryAddress String?
  deliveryMethod  DeliveryMethod
  status          OrderStatus    @default(PENDING)
  notes           String         @default("")
  createdById     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  cancelledAt     DateTime?
  cancelReason    String?
  deletedAt       DateTime?
  currentTotal    Decimal        @db.Decimal(12, 2)
  originalTotal   Decimal        @db.Decimal(12, 2)
  expenses        Expense[]
  ledgerEntries   LedgerEntry[]
  createdBy       User           @relation("UserCreatedOrders", fields: [createdById], references: [id])
  customer        Customer       @relation("CustomerOrders", fields: [customerId], references: [customerId])
  items           OrderItem[]
  payments        Payment[]

  @@index([orderNumber])
  @@index([customerId])
  @@index([createdById])
  @@index([status])
  @@index([deliveryDate])
  @@index([deliveryDate, status])
  @@index([orderDate])
}

model OrderItem {
  id                String          @id @default(cuid())
  productCategoryId String
  productName       String
  quantity          Int             @default(1)
  unitPrice         Decimal         @db.Decimal(12, 2)
  totalPrice        Decimal         @db.Decimal(12, 2)
  details           Json            @default("{}")
  status            OrderItemStatus @default(PENDING)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  itemId            String          @unique
  orderNumber       String
  order             Order           @relation(fields: [orderNumber], references: [orderNumber])
  productCategory   ProductCategory @relation(fields: [productCategoryId], references: [categoryId])

  @@index([orderNumber])
  @@index([productCategoryId])
  @@index([status])
}

model Payment {
  id            String        @id @default(cuid())
  paymentNumber String        @unique
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  paymentDate   DateTime      @default(now())
  paymentSource PaymentSource @default(MANUAL)
  reference     String?
  notes         String        @default("")
  receivedById  String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  orderNumber   String
  status        PaymentStatus @default(COMPLETED)
  tipAmount     Decimal       @default(0) @db.Decimal(12, 2)
  order         Order         @relation(fields: [orderNumber], references: [orderNumber])
  receivedBy    User          @relation("UserReceivedPayments", fields: [receivedById], references: [id])
  receipt       Receipt?
  refunds       Refund[]

  @@index([orderNumber])
  @@index([paymentDate])
  @@index([orderNumber, paymentDate])
  @@index([paymentMethod])
  @@index([receivedById])
  @@index([status])
}

model Refund {
  id            String        @id @default(cuid())
  refundNumber  String        @unique
  paymentNumber String
  amount        Decimal       @db.Decimal(12, 2)
  refundMethod  PaymentMethod
  refundDate    DateTime      @default(now())
  reason        String
  reference     String?
  processedById String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  refundType    RefundType    @default(PAYMENT)
  payment       Payment       @relation(fields: [paymentNumber], references: [paymentNumber])
  processedBy   User          @relation("UserProcessedRefunds", fields: [processedById], references: [id])

  @@index([paymentNumber])
  @@index([refundDate])
  @@index([processedById])
}

model Expense {
  id                String          @id @default(cuid())
  expenseNumber     String          @unique
  expenseCategoryId String
  title             String
  amount            Decimal         @db.Decimal(12, 2)
  expenseDate       DateTime        @default(now())
  description       String          @default("")
  receiptUrl        String?
  recordedById      String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  orderNumber       String?
  expenseCategory   ExpenseCategory @relation(fields: [expenseCategoryId], references: [categoryId])
  order             Order?          @relation(fields: [orderNumber], references: [orderNumber], onDelete: Restrict)
  recordedBy        User            @relation("UserRecordedExpenses", fields: [recordedById], references: [id])

  @@index([orderNumber])
  @@index([expenseCategoryId])
  @@index([recordedById])
  @@index([expenseDate])
  @@index([expenseCategoryId, expenseDate])
}

model LedgerEntry {
  id              String              @id @default(cuid())
  entryNumber     String              @unique
  type            LedgerEntryType
  direction       LedgerDirection
  amount          Decimal             @db.Decimal(12, 2)
  balanceAfter    Decimal             @db.Decimal(12, 2)
  description     String?
  referenceType   LedgerReferenceType
  referenceId     String
  createdById     String
  createdAt       DateTime            @default(now())
  orderNumber     String?
  ledgerAccountId String
  createdBy       User                @relation("UserCreatedLedgerEntries", fields: [createdById], references: [id])
  ledgerAccount   LedgerAccount       @relation(fields: [ledgerAccountId], references: [id])
  order           Order?              @relation(fields: [orderNumber], references: [orderNumber])

  @@index([ledgerAccountId])
  @@index([type])
  @@index([direction])
  @@index([referenceType, referenceId])
  @@index([createdById])
  @@index([createdAt])
}

model LedgerAccount {
  id             String        @id @default(cuid())
  name           String        @unique
  currentBalance Decimal       @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  ledgerEntries  LedgerEntry[]
}

model Receipt {
  id              String          @id @default(cuid())
  receiptNumber   String          @unique
  paymentId       String          @unique
  generatedById   String
  storageProvider StorageProvider @default(LOCAL)
  storageKey      String?
  emailedAt       DateTime?
  createdAt       DateTime        @default(now())
  generatedBy     User            @relation("UserGeneratedReceipts", fields: [generatedById], references: [id])
  payment         Payment         @relation(fields: [paymentId], references: [id])

  @@index([receiptNumber])
  @@index([generatedById])
  @@index([createdAt])
}

model Notification {
  id            String                     @id @default(cuid())
  userId        String
  title         String
  message       String
  type          NotificationType
  channel       NotificationChannel
  isRead        Boolean                    @default(false)
  readAt        DateTime?
  referenceType NotificationReferenceType?
  referenceId   String?
  createdAt     DateTime                   @default(now())
  user          User                       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([channel])
  @@index([isRead])
  @@index([createdAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())
}

model Sequence {
  id        String   @id @default(cuid())
  name      String   @unique
  value     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Counter {
  value     Int         @default(0)
  updatedAt DateTime    @updatedAt
  id        Int         @id @default(autoincrement())
  name      CounterName @unique
}

enum UserRole {
  ADMIN
  STAFF
}

enum Currency {
  NGN
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  POS
  MOBILE_MONEY
  OTHER
}

enum PaymentSource {
  MANUAL
  ONLINE
}

enum PaymentStatus {
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundType {
  PAYMENT
  TIP
}

enum LedgerDirection {
  IN
  OUT
}

enum LedgerEntryType {
  ORDER_PAYMENT
  TIP
  EXPENSE
  REFUND
  ADJUSTMENT
  OPENING_BALANCE
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum LedgerReferenceType {
  PAYMENT
  EXPENSE
  REFUND
  OPENING_BALANCE
  ADJUSTMENT
}

enum NotificationType {
  ORDER_CREATED
  ORDER_UPDATED
  ORDER_CANCELLED
  DELIVERY_REMINDER
  PAYMENT_RECEIVED
  PAYMENT_REFUNDED
  EXPENSE_RECORDED
  WEEKLY_REPORT
  MONTHLY_REPORT
  SYSTEM
}

enum NotificationReferenceType {
  ORDER
  PAYMENT
  EXPENSE
  RECEIPT
  SYSTEM
}

enum StorageProvider {
  LOCAL
  CLOUDINARY
  S3
}

enum CounterName {
  USER
  CUSTOMER
  PRODUCT_CATEGORY
  ORDER
  PAYMENT
  EXPENSE
  RECEIPT
  ITEM
  REFUND
  EXPENSE_CATEGORY
  ENTRY
}
