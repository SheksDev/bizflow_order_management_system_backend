// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
}

enum Currency {
  NGN
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  POS
  MOBILE_MONEY
  OTHER
}

enum PaymentSource {
  MANUAL
  ONLINE
}

enum PaymentStatus {
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundType {
  PAYMENT
  TIP
}

enum LedgerDirection {
  IN
  OUT
}

enum LedgerEntryType {
  ORDER_PAYMENT
  TIP
  EXPENSE
  REFUND
  ADJUSTMENT
  OPENING_BALANCE
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum LedgerReferenceType {
  PAYMENT
  EXPENSE
  REFUND
  OPENING_BALANCE
  ADJUSTMENT
}

enum NotificationType {
  ORDER_CREATED
  ORDER_UPDATED
  ORDER_CANCELLED
  DELIVERY_REMINDER
  PAYMENT_RECEIVED
  PAYMENT_REFUNDED
  EXPENSE_RECORDED
  WEEKLY_REPORT
  MONTHLY_REPORT
  SYSTEM
}

enum NotificationReferenceType {
  ORDER
  PAYMENT
  EXPENSE
  RECEIPT
  SYSTEM
}

enum StorageProvider {
  LOCAL
  CLOUDINARY
  S3
}

enum CounterName {
  USER
  CUSTOMER
  PRODUCT_CATEGORY
  ORDER
  ITEM
  PAYMENT
  EXPENSE_CATEGORY
  EXPENSE
  RECEIPT
  REFUND
}

model Business {
  id           String   @id @default(cuid())
  businessName String
  logoKey      String?
  phone        String?
  email        String?
  address      String?
  currency     Currency @default(NGN)

  bankName      String?
  accountName   String?
  accountNumber String?

  receiptFooter String?

  instagram String?
  facebook  String?
  whatsapp  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id String @id @default(cuid())

  userId    String      @unique

  firstName String
  lastName  String

  email        String @unique
  phone        String?
  passwordHash String
  hashedRefreshToken    String?

  role UserRole @default(ADMIN)

  isActive Boolean @default(true)

  lastLoginAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdCustomers     Customer[]     @relation("CustomerCreatedBy")
  createdOrders        Order[]        @relation("UserCreatedOrders")
  receivedPayments     Payment[]      @relation("UserReceivedPayments")
  recordedExpenses     Expense[]      @relation("UserRecordedExpenses")
  createdLedgerEntries LedgerEntry[]  @relation("UserCreatedLedgerEntries")
  generatedReceipts    Receipt[]      @relation("UserGeneratedReceipts")
  processedRefunds     Refund[]       @relation("UserProcessedRefunds")
  notifications        Notification[]

  @@index([email])
  @@index([role])
}

model Customer {
  id             String       @id @default(cuid())

  customerId     String      @unique

  name           String
  phone          String
  email          String?
  defaultAddress String?
  notes          String  @default("")

  createdById String
  createdBy   User   @relation("CustomerCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  orders    Order[] @relation("CustomerOrders")

  @@index([name])
  @@index([phone])
  @@index([createdById])
}

model ProductCategory {
  id String @id @default(cuid())

  categoryId  String     @unique

  name        String @unique
  description String @default("")

  isActive Boolean @default(true)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([isActive])
}

model ExpenseCategory {
  id String @id @default(cuid())

  categoryId    String    @unique

  name        String @unique
  description String @default("")

  isActive Boolean @default(true)

  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([isActive])
}

model Order {
  id String @id @default(cuid())

  orderNumber String @unique

  customerId String
  customer   Customer @relation("CustomerOrders", fields: [customerId], references: [customerId], onDelete: Restrict)

  orderDate DateTime @default(now())

  deliveryDate    DateTime
  deliveryAddress String?
  deliveryMethod DeliveryMethod

  status OrderStatus @default(PENDING)

  originalTotal Decimal @db.Decimal(12, 2)
  currentTotal Decimal @db.Decimal(12, 2)

  notes       String  @default("")

  items OrderItem[]

  payments      Payment[]
  expenses      Expense[]
  ledgerEntries LedgerEntry[]

  createdById String
  createdBy   User   @relation("UserCreatedOrders", fields: [createdById], references: [id])

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  cancelledAt  DateTime?
  cancelReason String?
  deletedAt    DateTime?

  @@index([orderNumber])
  @@index([customerId])
  @@index([createdById])
  @@index([status])
  @@index([deliveryDate])
  @@index([deliveryDate, status])
  @@index([orderDate])
}

model OrderItem {
  id String @id @default(cuid())

  itemId    String   @unique

  orderNumber String
  order   Order  @relation(fields: [orderNumber], references: [orderNumber])

  productCategoryId String
  productCategory   ProductCategory @relation(fields: [productCategoryId], references: [categoryId])

  productName String

  quantity   Int     @default(1)
  unitPrice  Decimal @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)

  details Json @default("{}")

  status OrderItemStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderNumber])
  @@index([productCategoryId])
  @@index([status])
}

model Payment {
  id String @id @default(cuid())

  paymentNumber String @unique

  orderNumber String
  order   Order  @relation(fields: [orderNumber], references: [orderNumber], onDelete: Restrict)

  amount Decimal @db.Decimal(12, 2)

  paymentMethod PaymentMethod

  paymentDate DateTime @default(now())

  paymentSource PaymentSource @default(MANUAL)

  status    PaymentStatus   @default(COMPLETED)

  reference String?

  tipAmount   Decimal     @default(0) @db.Decimal(12, 2)

  notes String @default("")

  receivedById String
  receivedBy   User   @relation("UserReceivedPayments", fields: [receivedById], references: [id])

  receipt Receipt?

  refunds   Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderNumber])
  @@index([paymentDate])
  @@index([orderNumber, paymentDate])
  @@index([paymentMethod])
  @@index([receivedById])
  @@index([status])
}

model Refund {
  id String @id @default(cuid())

  refundNumber String @unique

  paymentNumber String
  payment   Payment @relation(fields: [paymentNumber], references: [paymentNumber], onDelete: Restrict)

  amount Decimal @db.Decimal(12, 2)

  refundMethod PaymentMethod

  refundDate DateTime @default(now())

  refundType   RefundType   @default(PAYMENT)

  reason String

  reference String?

  processedById String
  processedBy   User @relation("UserProcessedRefunds", fields: [processedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentNumber])
  @@index([refundDate])
  @@index([processedById])
}

model Expense {
  id String @id @default(cuid())

  expenseNumber String @unique

  orderNumber String?
  order   Order?  @relation(fields: [orderNumber], references: [orderNumber], onDelete: Restrict)

  expenseCategoryId String
  expenseCategory   ExpenseCategory @relation(fields: [expenseCategoryId], references: [categoryId])

  title String

  amount Decimal @db.Decimal(12, 2)

  expenseDate DateTime @default(now())

  description String @default("")

  receiptUrl String?

  recordedById String
  recordedBy   User   @relation("UserRecordedExpenses", fields: [recordedById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([orderNumber])
  @@index([expenseCategoryId])
  @@index([recordedById])
  @@index([expenseDate])
  @@index([expenseCategoryId, expenseDate])
}

model LedgerEntry {
  id String @id @default(cuid())

  entryNumber String @unique

  type LedgerEntryType

  direction LedgerDirection

  amount Decimal @db.Decimal(12, 2)

  balanceAfter Decimal @db.Decimal(12, 2)

  description String

  referenceType LedgerReferenceType
  referenceId   String

  createdById String
  createdBy   User   @relation("UserCreatedLedgerEntries", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  order     Order?   @relation(fields: [orderId], references: [id])
  orderId   String?

  @@index([type])
  @@index([direction])
  @@index([referenceType, referenceId])
  @@index([createdById])
  @@index([createdAt])
}

model Receipt {
  id String @id @default(cuid())

  receiptNumber String @unique

  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id])

  generatedById String
  generatedBy   User   @relation("UserGeneratedReceipts", fields: [generatedById], references: [id])

  storageProvider StorageProvider @default(LOCAL)

  storageKey String?

  emailedAt DateTime?

  createdAt DateTime @default(now())

  @@index([receiptNumber])
  @@index([generatedById])
  @@index([createdAt])
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  title String

  message String

  type NotificationType

  channel NotificationChannel

  isRead Boolean @default(false)

  readAt DateTime?

  referenceType NotificationReferenceType?

  referenceId String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([channel])
  @@index([isRead])
  @@index([createdAt])
}

model ActivityLog {
  id String @id @default(cuid())

  userId String

  action String

  entity String

  entityId String

  metadata Json?

  createdAt DateTime @default(now())
}

model Sequence {

  id        String   @id @default(cuid())

  name      String   @unique

  value     Int      @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Counter {

  id          Int           @id @default(autoincrement())

  name        CounterName   @unique

  value       Int           @default(0)

  updatedAt   DateTime      @updatedAt
}